{
  "name": "recupero",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "format:changed": "biome format --write $(git diff --name-only HEAD --diff-filter=ACMR; git ls-files --others --exclude-standard | grep -E '\\.(ts|tsx|json)$')",
    "format:imports": "biome check --write --only=organizeImports",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android:local": "eas build --platform android --profile development --local --non-interactive --output ./builds/recupero.apk && cd builds && NAME=recupero-$(date +%Y%m%d%H%M) && mv recupero.apk $NAME.apk && zip $NAME.zip $NAME.apk",
    "build:android:eas": "eas build --platform android --profile development --non-interactive",
    "build:android:prod:eas": "eas build --platform android --profile production --non-interactive",
    "test:maestro": "maestro test",
    "test:maestro:all": "maestro test .maestro",
    "emulator": "$ANDROID_HOME/emulator/emulator -netdelay none -netspeed full -no-snapshot-load -avd maestro_test",
    "emulator:stop": "adb emu kill",
    "test:unit": "jest",
    "ota:android:dev": "eas update --platform android --branch development --environment development --auto",
    "ota:android:pre": "eas update --platform android --branch preview --environment preview --auto"
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.7",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "date-fns": "^4.4.0",
    "emojibase-data": "^17.0.0",
    "expo": "~57.0.8",
    "expo-constants": "^57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-location": "~57.0.6",
    "expo-module-scripts": "^56.0.3",
    "expo-notifications": "~57.0.7",
    "expo-sharing": "~57.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.6",
    "expo-updates": "^57.0.10",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-calendars": "^1.1314.0",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.0",
    "rn-emoji-keyboard": "^1.7.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "jest": "^29.7.0",
    "ts-jest": "29",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "patchedDependencies": {
      "rn-emoji-keyboard@1.7.0": "patches/rn-emoji-keyboard@1.7.0.patch",
      "expo-dev-launcher@57.0.9": "patches/expo-dev-launcher@57.0.9.patch"
    }
  }
}
